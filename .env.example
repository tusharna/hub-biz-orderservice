# Application
NODE_ENV=development
PORT=3000

# Azure Cosmos DB for NoSQL (orders container partition key: /orderId)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=ecommerce
COSMOS_ORDERS_CONTAINER=orders

# Azure Service Bus (queue: orders-queue)
SERVICE_BUS_NAMESPACE=your-namespace.servicebus.windows.net
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key
SERVICE_BUS_ORDERS_QUEUE=orders-queue
# Set to false in tests or when running API-only without a consumer in the same process
SERVICE_BUS_CONSUMER_ENABLED=true
# Development only. true abandons every message so you can watch redelivery. Ignored when NODE_ENV=production.
SERVICE_BUS_SIMULATE_TRANSIENT_FAILURE=false
SERVICE_BUS_ORDERS_TOPIC=
OUTBOX_PUBLISHER_ENABLED=true
SERVICE_BUS_SESSIONS_ENABLED=false
SERVICE_BUS_PREFETCH=0
SERVICE_BUS_MAX_CONCURRENT_CALLS=1
PROCESSED_EVENT_TTL_SECONDS=604800
ORDER_REMINDER_DELAY_SECONDS=15
APP_ROLE=all
REDIS_URL=
PRODUCT_CACHE_TTL_SECONDS=60
